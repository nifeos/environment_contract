Falsifies `environment_contract::verification::any_members_round_trip`.

The defect: `write_field` writes a length one short of the value it copies, so a built page's
field holds a prefix of the member it was given.

Expected to fail: the harness's `assert_eq!(read.time_zone(), Some(time_zone))`, since the prefix
is not a member of the list and the reader answers `None`.

diff --git a/src/lib.rs b/src/lib.rs
index fd31da7..7b2e559 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -311,7 +311,7 @@ fn write_field(
     let bytes = value.as_bytes();
     assert!(bytes.len() <= maximum_bytes);
     let n = bytes.len();
-    page[length_offset] = n as u8;
+    page[length_offset] = (n - 1) as u8;
     page[value_offset..value_offset + n].copy_from_slice(bytes);
 }
 
